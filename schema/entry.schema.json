{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"properties": {
		"name": {
			"type": "string"
		},
		"url": {
			"type": "string",
			"format": "uri",
			"pattern": "^https://([^/?#\\s@]*@)?[^/?#\\s@:]+(:[0-9]*)?([/?#]|$)",
			"description": "The project's homepage, or its repository if it has no homepage."
		},
		"repo": {
			"type": "string",
			"pattern": "^[\\w.-]+\\/[\\w.-]+$",
			"description": "The GitHub owner/name that the weekly checker watches. Leave it out for projects that aren't on GitHub."
		},
		"role": {
			"type": "string",
			"enum": ["program", "terminal"],
			"description": "program if it sends status reports, terminal if it shows them."
		},
		"category": {
			"type": "string",
			"enum": ["coding-agents", "clis", "libraries", "emulators", "multiplexers", "engines"]
		},
		"is_featured": {
			"type": "boolean",
			"description": "Set true to feature an entry with fewer than 1,000 stars, or false to hide one with more. Leave it out to go by stars."
		},
		"aliases": {
			"type": "array",
			"items": {
				"type": "string"
			},
			"description": "Other names that search should match, such as agentd for agtd."
		},
		"spec_revision": {
			"type": "string",
			"description": "The OSC 7501 spec revision of the last check, such as 0.4."
		},
		"note": {
			"type": "string",
			"description": "A caveat that the popover shows, such as how to turn support on."
		},
		"last_checked_date": {
			"type": "string",
			"format": "date"
		},
		"github": {
			"type": "object",
			"properties": {
				"stars": {
					"type": "integer",
					"minimum": 0,
					"maximum": 9007199254740991
				},
				"latest_release_tag": {
					"type": "string"
				},
				"latest_release_date": {
					"type": "string",
					"format": "date"
				}
			},
			"required": ["stars"],
			"additionalProperties": false,
			"description": "Written by the weekly checker. Don't edit it by hand."
		},
		"history": {
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"date": {
						"anyOf": [
							{
								"type": "string",
								"format": "date-time"
							},
							{
								"type": "string",
								"format": "date"
							}
						],
						"description": "When the state or its evidence changed. A date-time is in UTC."
					},
					"state": {
						"type": "string",
						"enum": ["done", "working", "blocked", "idle", "error"],
						"description": "The state from this date on."
					},
					"source": {
						"type": "string",
						"format": "uri",
						"pattern": "^https://([^/?#\\s@]*@)?[^/?#\\s@:]+(:[0-9]*)?([/?#]|$)",
						"description": "The PR, commit, release, issue or docs page that shows this state."
					},
					"version": {
						"type": "string",
						"description": "The release that shipped support."
					}
				},
				"required": ["date", "state", "source"],
				"additionalProperties": false
			},
			"description": "State changes, oldest first. The last block is the current state, and no blocks means idle."
		}
	},
	"required": ["name", "url", "role", "category", "spec_revision", "last_checked_date", "history"],
	"additionalProperties": false,
	"allOf": [
		{
			"if": {
				"properties": {
					"role": {
						"const": "program"
					}
				},
				"required": ["role"]
			},
			"then": {
				"properties": {
					"category": {
						"enum": ["coding-agents", "clis", "libraries"]
					}
				}
			}
		},
		{
			"if": {
				"properties": {
					"role": {
						"const": "terminal"
					}
				},
				"required": ["role"]
			},
			"then": {
				"properties": {
					"category": {
						"enum": ["emulators", "multiplexers", "engines"]
					}
				}
			}
		},
		{
			"if": {
				"properties": {
					"url": {
						"pattern": "^https://([^/?#\\s@]*@)?github\\.com(:[0-9]*)?/+([^/?#]+)/+([^/?#]+)([/?#]|$)"
					}
				},
				"required": ["url"]
			},
			"then": {
				"required": ["repo"]
			}
		},
		{
			"if": {
				"required": ["repo"]
			},
			"then": {
				"properties": {
					"history": {
						"items": {
							"if": {
								"properties": {
									"state": {
										"const": "done"
									}
								},
								"required": ["state"]
							},
							"then": {
								"required": ["version"]
							}
						}
					}
				}
			}
		}
	]
}
