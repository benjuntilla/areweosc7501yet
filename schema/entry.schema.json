{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"properties": {
		"name": {
			"type": "string",
			"description": "Display name"
		},
		"url": {
			"type": "string",
			"format": "uri",
			"pattern": "^https://([^/?#\\s@]*@)?[^/?#\\s@:]+(:[0-9]*)?([/?#]|$)",
			"description": "Homepage or repo"
		},
		"repo": {
			"type": "string",
			"pattern": "^[\\w.-]+\\/[\\w.-]+$",
			"description": "GitHub owner/name the checker watches. Leave it out off GitHub"
		},
		"role": {
			"type": "string",
			"enum": ["program", "terminal"],
			"description": "Programs send reports, terminals show them"
		},
		"category": {
			"type": "string",
			"enum": ["coding-agents", "clis", "libraries", "emulators", "multiplexers", "engines"]
		},
		"is_featured": {
			"type": "boolean",
			"description": "Overrides the 1,000-star rule either way"
		},
		"aliases": {
			"type": "array",
			"items": {
				"type": "string"
			},
			"description": "Extra search terms"
		},
		"spec_revision": {
			"type": "string",
			"description": "Spec revision it was checked against"
		},
		"note": {
			"type": "string",
			"description": "Caveat shown in the popover"
		},
		"last_checked_date": {
			"type": "string",
			"format": "date",
			"description": "Last re-verification"
		},
		"github": {
			"type": "object",
			"properties": {
				"stars": {
					"type": "integer",
					"minimum": 0,
					"maximum": 9007199254740991
				},
				"latest_release_tag": {
					"type": "string"
				},
				"latest_release_date": {
					"type": "string",
					"format": "date"
				}
			},
			"required": ["stars"],
			"additionalProperties": false,
			"description": "Written by the weekly checker"
		},
		"history": {
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"date": {
						"anyOf": [
							{
								"type": "string",
								"format": "date"
							},
							{
								"type": "string",
								"format": "date-time"
							}
						],
						"description": "When the state or its evidence changed, in UTC"
					},
					"state": {
						"type": "string",
						"enum": ["done", "working", "blocked", "idle", "error"],
						"description": "State from this date on"
					},
					"source": {
						"type": "string",
						"format": "uri",
						"pattern": "^https://([^/?#\\s@]*@)?[^/?#\\s@:]+(:[0-9]*)?([/?#]|$)",
						"description": "The PR, commit, release, issue or docs page it rests on"
					},
					"version": {
						"type": "string",
						"description": "The release that shipped it"
					}
				},
				"required": ["date", "state", "source"],
				"additionalProperties": false
			},
			"description": "Oldest first. The last block is the current state. No blocks means idle"
		}
	},
	"required": ["name", "url", "role", "category", "spec_revision", "last_checked_date", "history"],
	"additionalProperties": false,
	"allOf": [
		{
			"if": {
				"properties": {
					"role": {
						"const": "program"
					}
				},
				"required": ["role"]
			},
			"then": {
				"properties": {
					"category": {
						"enum": ["coding-agents", "clis", "libraries"]
					}
				}
			}
		},
		{
			"if": {
				"properties": {
					"role": {
						"const": "terminal"
					}
				},
				"required": ["role"]
			},
			"then": {
				"properties": {
					"category": {
						"enum": ["emulators", "multiplexers", "engines"]
					}
				}
			}
		},
		{
			"if": {
				"properties": {
					"url": {
						"pattern": "^https://[Gg][Ii][Tt][Hh][Uu][Bb]\\.[Cc][Oo][Mm]/[^/?#]+/[^/?#]+([/?#]|$)"
					}
				},
				"required": ["url"]
			},
			"then": {
				"required": ["repo"]
			}
		},
		{
			"if": {
				"required": ["repo"]
			},
			"then": {
				"properties": {
					"history": {
						"items": {
							"if": {
								"properties": {
									"state": {
										"const": "done"
									}
								},
								"required": ["state"]
							},
							"then": {
								"required": ["version"]
							}
						}
					}
				}
			}
		}
	]
}
