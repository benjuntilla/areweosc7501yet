{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"properties": {
		"schemaVersion": {
			"type": "number",
			"enum": [1]
		},
		"generatedAt": {
			"type": "string"
		},
		"spec": {
			"type": "object",
			"properties": {
				"current": {
					"type": "string"
				},
				"revisions": {
					"type": "array",
					"items": {
						"type": "object",
						"properties": {
							"number": {
								"type": "string"
							},
							"date": {
								"type": "string",
								"format": "date"
							},
							"url": {
								"type": "string",
								"format": "uri",
								"pattern": "^https://"
							}
						},
						"required": ["number", "date", "url"],
						"additionalProperties": false
					}
				}
			},
			"required": ["current", "revisions"],
			"additionalProperties": false
		},
		"verdicts": {
			"type": "object",
			"properties": {
				"program": {
					"type": "object",
					"properties": {
						"word": {
							"type": "string",
							"enum": ["Yes", "Almost", "Halfway", "Hardly", "No"]
						},
						"score": {
							"anyOf": [
								{
									"type": "number"
								},
								{
									"type": "string",
									"enum": ["Infinity", "-Infinity", "NaN"]
								}
							]
						},
						"done": {
							"type": "integer",
							"minimum": -9007199254740991,
							"maximum": 9007199254740991
						},
						"working": {
							"type": "integer",
							"minimum": -9007199254740991,
							"maximum": 9007199254740991
						},
						"featured": {
							"type": "integer",
							"minimum": -9007199254740991,
							"maximum": 9007199254740991
						}
					},
					"required": ["word", "score", "done", "working", "featured"],
					"additionalProperties": false
				},
				"terminal": {
					"type": "object",
					"properties": {
						"word": {
							"type": "string",
							"enum": ["Yes", "Almost", "Halfway", "Hardly", "No"]
						},
						"score": {
							"anyOf": [
								{
									"type": "number"
								},
								{
									"type": "string",
									"enum": ["Infinity", "-Infinity", "NaN"]
								}
							]
						},
						"done": {
							"type": "integer",
							"minimum": -9007199254740991,
							"maximum": 9007199254740991
						},
						"working": {
							"type": "integer",
							"minimum": -9007199254740991,
							"maximum": 9007199254740991
						},
						"featured": {
							"type": "integer",
							"minimum": -9007199254740991,
							"maximum": 9007199254740991
						}
					},
					"required": ["word", "score", "done", "working", "featured"],
					"additionalProperties": false
				}
			},
			"required": ["program", "terminal"],
			"additionalProperties": false
		},
		"entries": {
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"slug": {
						"type": "string"
					},
					"name": {
						"type": "string",
						"description": "Display name"
					},
					"url": {
						"type": "string",
						"format": "uri",
						"pattern": "^https://",
						"description": "Homepage or repo"
					},
					"repo": {
						"type": "string",
						"pattern": "^[\\w.-]+\\/[\\w.-]+$",
						"description": "GitHub owner/name the checker watches. Leave it out off GitHub"
					},
					"role": {
						"type": "string",
						"enum": ["program", "terminal"],
						"description": "Programs send reports, terminals show them"
					},
					"category": {
						"type": "string",
						"enum": ["coding-agents", "clis", "libraries", "emulators", "multiplexers", "engines"]
					},
					"is_featured": {
						"type": "boolean",
						"description": "Overrides the 1,000-star rule either way"
					},
					"aliases": {
						"type": "array",
						"items": {
							"type": "string"
						},
						"description": "Extra search terms"
					},
					"spec_revision": {
						"type": "string",
						"description": "Spec revision it was checked against"
					},
					"note": {
						"type": "string",
						"description": "Caveat shown in the popover"
					},
					"last_checked_date": {
						"type": "string",
						"format": "date",
						"description": "Last re-verification"
					},
					"github": {
						"type": "object",
						"properties": {
							"stars": {
								"type": "integer",
								"minimum": 0,
								"maximum": 9007199254740991
							},
							"latest_release_tag": {
								"type": "string"
							},
							"latest_release_date": {
								"type": "string",
								"format": "date"
							}
						},
						"required": ["stars"],
						"additionalProperties": false,
						"description": "Written by the weekly checker"
					},
					"history": {
						"type": "array",
						"items": {
							"type": "object",
							"properties": {
								"date": {
									"anyOf": [
										{
											"type": "string",
											"format": "date"
										},
										{
											"type": "string",
											"format": "date-time"
										}
									],
									"description": "When the state or its evidence changed, in UTC"
								},
								"state": {
									"type": "string",
									"enum": ["done", "working", "blocked", "idle", "error"],
									"description": "State from this date on"
								},
								"source": {
									"type": "string",
									"format": "uri",
									"pattern": "^https://",
									"description": "The PR, commit, release, issue or docs page it rests on"
								},
								"version": {
									"type": "string",
									"description": "The release that shipped it"
								}
							},
							"required": ["date", "state", "source"],
							"additionalProperties": false
						},
						"description": "Oldest first. The last block is the current state. No blocks means idle"
					},
					"state": {
						"type": "string",
						"enum": ["done", "working", "blocked", "idle", "error"]
					},
					"featured": {
						"type": "boolean"
					}
				},
				"required": [
					"slug",
					"name",
					"url",
					"role",
					"category",
					"spec_revision",
					"last_checked_date",
					"history",
					"state",
					"featured"
				],
				"additionalProperties": false
			}
		}
	},
	"required": ["schemaVersion", "generatedAt", "spec", "verdicts", "entries"],
	"additionalProperties": false
}
