{
	$schema: 'https://docs.renovatebot.com/renovate-schema.json',
	// GitHub Actions keep their version tags: Renovate regenerates .github/workflows/actions.lock
	// instead of pinning digests in the workflows.
	extends: [
		'config:best-practices',
		'customManagers:githubActionsVersions',
		'group:allNonMajor',
		'schedule:weekly'
	],
	// Dependency PRs follow the repo's Conventional Commits titles: chore(deps): ...
	semanticCommits: 'enabled'
}
