{
	"ci": {
		"collect": {
			"staticDistDir": "build",
			"settings": { "chromeFlags": "--no-sandbox" }
		},
		"assert": {
			"assertions": {
				"categories:performance": ["error", { "minScore": 1 }],
				"categories:accessibility": ["error", { "minScore": 1 }]
			}
		},
		"upload": { "target": "filesystem", "outputDir": ".lighthouseci" }
	}
}
