{
	"ci": {
		"collect": {
			"staticDistDir": "build",
			"settings": { "chromeFlags": "--no-sandbox", "skipAudits": ["color-contrast"] }
		},
		"assert": {
			"assertions": {
				"categories:performance": ["error", { "minScore": 0.95 }],
				"categories:accessibility": ["error", { "minScore": 1 }],
				"resource-summary:script:size": ["error", { "maxNumericValue": 81920 }]
			}
		}
	}
}
