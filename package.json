{
	"name": "areweosc7501yet",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "oxlint && stylelint \"src/**/*.{css,svelte}\"",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"test": "vitest run",
		"schema": "node scripts/schema.ts && oxfmt schema",
		"tokens": "tz build --quiet && oxfmt src/styles/tokens.css"
	},
	"devDependencies": {
		"@cloudflare/build-output-utils": "0.9.4",
		"@cloudflare/config": "0.28.0",
		"@distilled.cloud/core": "1.0.0-rc.17",
		"@distilled.cloud/github": "1.0.0-rc.17",
		"@double-great/stylelint-a11y": "3.8.1",
		"@effect/platform-node": "4.0.6",
		"@effect/vitest": "4.0.6",
		"@effected/toml": "0.16.0",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@terrazzo/cli": "2.10.0",
		"@terrazzo/plugin-css": "2.10.0",
		"@tsconfig/strictest": "2.0.8",
		"cf": "1.0.0-beta.21",
		"effect": "4.0.6",
		"feed": "6.0.0",
		"lefthook": "2.2.2",
		"markdown-table": "3.0.4",
		"oxfmt": "0.74.0",
		"oxlint": "1.89.0",
		"oxlint-plugin-eslint": "1.89.0",
		"oxlint-tsgolint": "7.0.2005",
		"postcss-html": "2.0.0",
		"stylelint": "17.16.0",
		"stylelint-config-html": "2.0.0",
		"stylelint-config-recess-order": "7.9.0",
		"stylelint-config-standard": "40.0.0",
		"stylelint-declaration-strict-value": "1.12.1",
		"stylelint-order": "8.1.2",
		"stylelint-plugin-use-baseline": "1.4.8",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0",
		"vitest": "5.0.5"
	}
}
