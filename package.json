{
	"name": "areweosc7501yet",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "oxlint --config .config/oxlint.config.ts && stylelint --config .config/stylelint.config.ts \"src/**/*.{css,svelte}\"",
		"format": "oxfmt --config .config/oxfmt.config.ts",
		"format:check": "pnpm format --check",
		"test": "vitest run",
		"schema": "node scripts/schema.ts && pnpm format schema",
		"tokens": "tz build --quiet --config .config/terrazzo.config.ts && pnpm format src/styles/tokens.css",
		"checker": "GITHUB_TOKEN=$(gh auth token) node scripts/checker/main.ts --body /tmp/body.md"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.14.0",
		"@cloudflare/build-output-utils": "0.9.4",
		"@cloudflare/config": "0.28.0",
		"@distilled.cloud/core": "1.0.0-rc.17",
		"@distilled.cloud/github": "1.0.0-rc.17",
		"@double-great/stylelint-a11y": "3.8.1",
		"@effect/platform-node": "4.0.6",
		"@effect/vitest": "4.0.6",
		"@effected/toml": "0.16.0",
		"@lhci/cli": "0.15.1",
		"@playwright/test": "1.64.1",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@terrazzo/cli": "2.10.0",
		"@terrazzo/plugin-css": "2.10.0",
		"@tsconfig/strictest": "2.0.8",
		"cf": "1.0.0-beta.21",
		"effect": "4.0.6",
		"feed": "6.0.0",
		"html-validate": "11.17.0",
		"jscpd": "5.4.2",
		"knip": "6.43.0",
		"lefthook": "2.2.2",
		"markdown-table": "3.0.4",
		"oxfmt": "0.74.0",
		"oxlint": "1.89.0",
		"oxlint-plugin-eslint": "1.89.0",
		"oxlint-tsgolint": "7.0.2005",
		"postcss-html": "2.0.0",
		"stylelint": "17.16.0",
		"stylelint-config-html": "2.0.0",
		"stylelint-config-recess-order": "7.9.0",
		"stylelint-config-standard": "40.0.0",
		"stylelint-declaration-strict-value": "1.12.1",
		"stylelint-order": "8.1.2",
		"stylelint-plugin-use-baseline": "1.4.8",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0",
		"vitest": "5.0.5"
	},
	"jscpd": {
		"ignore": [
			"schema/**",
			"src/styles/tokens.css",
			"tokens/**"
		],
		"exitCode": 1
	},
	"knip": {
		"entry": [
			"cloudflare.config.ts",
			".config/terrazzo.config.ts"
		],
		"ignoreExportsUsedInFile": true,
		"playwright": [
			".config/playwright.config.ts"
		],
		"stylelint": [
			".config/stylelint.config.ts"
		]
	}
}
