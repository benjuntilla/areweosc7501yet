{
	"name": "areweosc7501yet",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "oxlint",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"test": "vitest run",
		"schema": "node scripts/schema.ts && oxfmt schema"
	},
	"devDependencies": {
		"@cloudflare/build-output-utils": "0.9.4",
		"@cloudflare/config": "0.28.0",
		"@distilled.cloud/core": "1.0.0-rc.17",
		"@distilled.cloud/github": "1.0.0-rc.17",
		"@effect/platform-node": "4.0.6",
		"@effect/vitest": "4.0.6",
		"@effected/toml": "0.16.0",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tsconfig/strictest": "2.0.8",
		"cf": "1.0.0-beta.21",
		"effect": "4.0.6",
		"feed": "6.0.0",
		"lefthook": "2.2.2",
		"oxfmt": "0.74.0",
		"oxlint": "1.89.0",
		"oxlint-plugin-eslint": "1.89.0",
		"oxlint-tsgolint": "7.0.2005",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0",
		"vitest": "5.0.5"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "12.15.0",
			"onFail": "error"
		},
		"runtime": {
			"name": "node",
			"version": "24.22.1",
			"onFail": "download"
		}
	},
	"engines": {
		"node": ">=24.22"
	},
	"packageManager": "pnpm@12.15.0"
