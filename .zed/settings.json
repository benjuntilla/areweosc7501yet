{
	"auto_install_extensions": {
		"oxc": true,
		"svelte": true,
		"tombi": true
	},
	"format_on_save": "on",
	"formatter": {
		"language_server": {
			"name": "oxfmt"
		}
	},
	"prettier": {
		"allowed": false
	},
	"languages": {
		"TypeScript": {
			"language_servers": ["oxlint", "oxfmt", "!eslint", "..."]
		},
		"JavaScript": {
			"language_servers": ["oxlint", "oxfmt", "!eslint", "..."]
		},
		"Svelte": {
			"language_servers": ["oxlint", "oxfmt", "!eslint", "..."]
		},
		"TOML": {
			"language_servers": ["tombi", "oxfmt", "..."]
		}
	},
	"lsp": {
		"oxlint": {
			"initialization_options": {
				"settings": {
					"run": "onType",
					"typeAware": true,
					"unusedDisableDirectives": "deny",
					"configPath": ".config/oxlint.config.ts"
				}
			}
		},
		"oxfmt": {
			"initialization_options": {
				"settings": {
					"run": "onSave",
					"fmt.configPath": ".config/oxfmt.config.ts"
				}
			}
		}
	}
}
