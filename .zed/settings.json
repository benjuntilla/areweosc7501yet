{
	"auto_install_extensions": {
		"oxc": true,
		"svelte": true,
		"tombi": true
	},
	"format_on_save": "on",
	"hard_tabs": true,
	"tab_size": 2,
	"preferred_line_length": 100,
	"prettier": {
		"allowed": false
	},
	"languages": {
		"TypeScript": {
			"formatter": [
				{
					"language_server": {
						"name": "oxfmt"
					}
				}
			],
			"language_servers": ["oxlint", "oxfmt", "!eslint", "..."]
		},
		"JavaScript": {
			"formatter": [
				{
					"language_server": {
						"name": "oxfmt"
					}
				}
			],
			"language_servers": ["oxlint", "oxfmt", "!eslint", "..."]
		},
		"Svelte": {
			"formatter": [
				{
					"language_server": {
						"name": "oxfmt"
					}
				}
			],
			"language_servers": ["oxlint", "oxfmt", "!eslint", "..."]
		},
		"JSON": {
			"formatter": [
				{
					"language_server": {
						"name": "oxfmt"
					}
				}
			]
		},
		"JSONC": {
			"formatter": [
				{
					"language_server": {
						"name": "oxfmt"
					}
				}
			]
		},
		"TOML": {
			"formatter": [
				{
					"language_server": {
						"name": "oxfmt"
					}
				}
			],
			"language_servers": ["tombi", "oxfmt", "..."]
		},
		"Markdown": {
			"formatter": [
				{
					"language_server": {
						"name": "oxfmt"
					}
				}
			]
		},
		"CSS": {
			"formatter": [
				{
					"language_server": {
						"name": "oxfmt"
					}
				}
			]
		}
	},
	"lsp": {
		"oxlint": {
			"initialization_options": {
				"settings": {
					"run": "onType",
					"typeAware": true,
					"unusedDisableDirectives": "deny",
					"configPath": "oxlint.config.ts"
				}
			}
		},
		"oxfmt": {
			"initialization_options": {
				"settings": {
					"run": "onSave",
					"fmt.configPath": "oxfmt.config.ts"
				}
			}
		}
	}
}
